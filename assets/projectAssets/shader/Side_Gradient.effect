CCEffect %{
  techniques:
  - name: transparent
    passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        # 新增漸變屬性
        startColor: { value: [0.0, 0.8, 0.8, 1.0], editor: { type: color, tooltip: "兩側/起始顏色" } }
        endColor:   { value: [1.0, 1.0, 1.0, 1.0], editor: { type: color, tooltip: "中間/終點顏色" } }
        fadeMargin: { value: 0.1, editor: { slide: true, range: [0.0, 0.5], step: 0.01, tooltip: "左右兩端透明淡出邊界" } }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 v_color;
  out vec2 v_uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    pos = cc_matViewProj * pos;

    v_uv0 = a_texCoord;
    v_color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <embedded-alpha>
  #include <alpha-test>

  in vec4 v_color;
  in vec2 v_uv0;

  #if USE_TEXTURE
    #pragma builtin(local)
    uniform sampler2D cc_spriteTexture;
  #endif

  #pragma builtin(global)
  uniform Constants {
    vec4 startColor;
    vec4 endColor;
    float fadeMargin;
  };

  vec4 frag () {
    vec4 o = vec4(1.0);

    #if USE_TEXTURE
      o *= CCSampleWithAlphaSeparated(cc_spriteTexture, v_uv0);
    #endif

    // 1. 計算左右兩端向中間對稱的 0 ~ 1 漸變值 (t)
    float t = smoothstep(0.0, 0.5, abs(v_uv0.x - 0.5));
    vec4 gradientColor = mix(endColor, startColor, t);

    // 2. 計算左右兩側邊緣的透明度羽化 (Alpha 淡出)
    float fade = smoothstep(0.0, fadeMargin, v_uv0.x) * (1.0 - smoothstep(1.0 - fadeMargin, 1.0, v_uv0.x));

    // 3. 混合顏色與 Alpha
    o *= gradientColor * v_color;
    o.a *= fade;

    ALPHA_TEST(o);

    return o;
  }
}%